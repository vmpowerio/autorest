<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(LibraryFxTarget)' == 'portable' ">
    <Configuration Condition=" '$(Configuration)' == '' ">Portable-Debug</Configuration>
  </PropertyGroup>
  <ItemGroup Condition=" '$(LibraryFxTarget)' == 'portable' ">
    <!-- Candidate asset only: Profile111 compile/runtime qualification is still required before release. -->
